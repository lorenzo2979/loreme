+/* Only one authenticated owner task may use the physical GW006 IR controller.
+ * This backing object lives as long as the FreeRTOS task. */
+static gwir_fj_play_ops saved_ir_ops;
+
+static int verified_saved_ir(void *ctx)
+{
+    const gwir_ir_pipeline *p = (const gwir_ir_pipeline *)ctx;
+    return p && p->ready && p->bus.ops.board_ir_ready &&
+           p->bus.ops.board_ir_ready(p->bus.ops.ctx) == 1;
+}
+
+static int transmit_saved_ir(void *ctx, uint32_t carrier, uint16_t duty,
+                             const uint32_t *durations, uint16_t count,
+                             uint32_t gap)
+{
+    gwir_ir_pipeline *p = (gwir_ir_pipeline *)ctx;
+    if (verified_saved_ir(ctx) != 1 || !p->engine ||
+        !p->engine->hal.tx || !durations || !count) return -1;
+    return p->engine->hal.tx(p->engine->hal.ctx, carrier, duty,
+                             durations, count, gap);
+}
 
