+/* Historical non-installable proposal: 0x200000..0x6FFFFF.
+ * On 14 Nov 2026, 4 independently verified WBRG1 8MiB public dump references
+ * showed 606-646 NON-ERASED sectors inside that range. This partition MUST
+ * never be enabled based on this placeholder; identical/FF sectors also do
+ * not prove availability on an owner's GW006. Default: FAIL CLOSED.
+ * A production layout must be verified on the exact target and supplied as
+ * explicit build parameters, alongside independent recovery evidence.
  */
 #define GWIR_WBRG1_FLASH_BYTES 0x00800000u
-#define GWIR_WBRG1_IR_START    0x00200000u
-#define GWIR_WBRG1_IR_BYTES    0x00500000u
-
+#ifndef GWIR_WBRG1_IR_START
+#define GWIR_WBRG1_IR_START    0x00200000u /* PLACEHOLDER, NO WRITE */
+#define GWIR_WBRG1_PLACEHOLDER_START 1
+#endif
+#ifndef GWIR_WBRG1_IR_BYTES
+#define GWIR_WBRG1_IR_BYTES    0x00500000u /* PLACEHOLDER, NO WRITE */
+#define GWIR_WBRG1_PLACEHOLDER_BYTES 1
+#endif
 #ifndef GWIR_WBRG1_STORAGE_APPROVED
