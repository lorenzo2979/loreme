+#ifndef GWIR_WBRG1_BOARD_LAYOUT_VERIFIED
+#define GWIR_WBRG1_BOARD_LAYOUT_VERIFIED 0
+#endif
+#if GWIR_WBRG1_STORAGE_APPROVED == 1
+  /* Synthetic NOR tests are never allowed to authorize actual ARM firmware. */
+  #if defined(GWIR_WBRG1_HOST_NOR_TEST) && defined(__arm__)
+    #error "Mock-only override must not appear in ARM firmware"
+  #endif
+  #if !defined(GWIR_WBRG1_HOST_NOR_TEST)
+    #if GWIR_WBRG1_BOARD_LAYOUT_VERIFIED != 1
+      #error "GW006 FLASH BLOCKED: audited board layout and restoration evidence required"
+    #endif
+    #if defined(GWIR_WBRG1_PLACEHOLDER_START) || defined(GWIR_WBRG1_PLACEHOLDER_BYTES)
+      #error "GW006 FLASH BLOCKED: old 5MiB placeholder cannot be approved"
+    #endif
+  #endif
+#endif
 
